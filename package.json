{
  "name": "biolume",
  "version": "0.0.0",
  "type": "module",
  "description": "A deep-sea theme for VS Code: a mint glow on deep navy",
  "main": "index.js",
  "keywords": [
    "theme",
    "dark theme",
    "deep-sea theme",
    "mint theme",
    "glow theme",
    "navy theme"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/KostaD02/biolume/issues"
  },
  "homepage": "https://github.com/KostaD02/biolume#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KostaD02/biolume.git"
  },
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@kostad/brand": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.7",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
